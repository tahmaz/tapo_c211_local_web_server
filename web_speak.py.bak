"""
Speaker:
  - voices/ siyahısı + Send / Stop
  - browser mic → kamera (PTT, binary PCM s16le 8k)
"""
import hashlib
import json
import random
import re
import socket
import struct
import subprocess
import threading
import time
from pathlib import Path

from flask import Blueprint, jsonify, request

bp = Blueprint("speak", __name__)
_cfg = {}
_speak_lock = threading.Lock()
_stop_event = threading.Event()
_speaking = False
_speak_status = ""

# PTT: açıq talk session
_ptt_sock = None
_ptt_sid = None
_ptt_mux = None
_ptt_ts = 0
_ptt_lock = threading.Lock()


def init(cfg: dict):
    global _cfg
    _cfg = cfg


def _voices_dir() -> Path:
    return Path(_cfg["voices_dir"])


# ---------- list / stop / file speak ----------
@bp.get("/api/voices")
def api_voices():
    files = []
    d = _voices_dir()
    if d.is_dir():
        for p in sorted(d.iterdir()):
            if p.suffix.lower() in (".wav", ".mp3", ".m4a", ".ogg"):
                files.append({"name": p.name, "size": p.stat().st_size})
    return jsonify(files=files, speaking=_speaking, status=_speak_status)


@bp.post("/api/speak")
def api_speak():
    global _speaking, _speak_status
    data = request.get_json(force=True, silent=True) or {}
    name = Path(data.get("file") or "").name
    path = _voices_dir() / name
    if not path.is_file():
        return jsonify(ok=False, error="file not found"), 404

    def worker():
        global _speaking, _speak_status
        if not _speak_lock.acquire(blocking=False):
            _speak_status = "busy"
            return
        _stop_event.clear()
        _speaking = True
        _speak_status = f"playing {name}"
        try:
            speak_file(path, _stop_event)
            _speak_status = "stopped" if _stop_event.is_set() else "done"
        except Exception as e:
            _speak_status = f"error: {e}"
            print("speak error:", e)
        finally:
            _speaking = False
            _speak_lock.release()

    threading.Thread(target=worker, daemon=True).start()
    return jsonify(ok=True, file=name)


@bp.post("/api/speak_stop")
def api_speak_stop():
    _stop_event.set()
    return jsonify(ok=True, msg="stop requested")


# ---------- PTT: browser mic ----------
@bp.post("/api/ptt/start")
def api_ptt_start():
    global _ptt_sock, _ptt_sid, _ptt_mux, _ptt_ts
    with _ptt_lock:
        if _ptt_sock is not None:
            return jsonify(ok=True, msg="already open")
        try:
            sock, sid, mux = open_talk_session()
            _ptt_sock, _ptt_sid, _ptt_mux, _ptt_ts = sock, sid, mux, 0
            # PAT/PMT
            write_audio_part(sock, sid, mux.header())
            return jsonify(ok=True, session=sid)
        except Exception as e:
            _ptt_sock = _ptt_sid = _ptt_mux = None
            return jsonify(ok=False, error=str(e)), 500


@bp.post("/api/ptt/audio")
def api_ptt_audio():
    """Body: raw PCM s16le mono 8000 Hz"""
    global _ptt_ts
    raw = request.get_data()
    if not raw:
        return jsonify(ok=False, error="empty"), 400
    with _ptt_lock:
        if _ptt_sock is None or _ptt_mux is None:
            return jsonify(ok=False, error="ptt not started"), 400
        try:
            # s16le → alaw
            alaw = pcm_s16le_to_alaw(raw)
            # 160 byte frames (20ms)
            for i in range(0, len(alaw), 160):
                chunk = alaw[i : i + 160]
                if len(chunk) < 160:
                    chunk = chunk + b"\xD5" * (160 - len(chunk))
                write_audio_part(
                    _ptt_sock, _ptt_sid, _ptt_mux.payload(_ptt_ts, chunk)
                )
                _ptt_ts += 160
            return jsonify(ok=True, bytes=len(alaw))
        except Exception as e:
            return jsonify(ok=False, error=str(e)), 500


@bp.post("/api/ptt/stop")
def api_ptt_stop():
    global _ptt_sock, _ptt_sid, _ptt_mux, _ptt_ts
    with _ptt_lock:
        if _ptt_sock:
            try:
                _ptt_sock.close()
            except Exception:
                pass
        _ptt_sock = _ptt_sid = _ptt_mux = None
        _ptt_ts = 0
    return jsonify(ok=True)


# ---------- alaw helpers ----------
def _linear_to_alaw(sample: int) -> int:
    sample = max(-32768, min(32767, sample))
    sign = 0x80 if sample < 0 else 0x00
    if sample < 0:
        sample = -sample
    sample >>= 3
    if sample > 0xFFF:
        sample = 0xFFF
    exp = 7
    for e in range(1, 8):
        if sample < (0x20 << e):
            exp = e
            break
    else:
        exp = 7
    mant = (sample >> (exp + 1)) & 0x0F if exp > 0 else (sample >> 1) & 0x0F
    alaw = sign | (exp << 4) | mant
    return alaw ^ 0x55


def pcm_s16le_to_alaw(data: bytes) -> bytes:
    out = bytearray()
    for i in range(0, len(data) - 1, 2):
        sample = struct.unpack_from("<h", data, i)[0]
        out.append(_linear_to_alaw(sample))
    return bytes(out)


# ---------- Tapo talk protocol ----------
def md5_colon(*parts):
    h = hashlib.md5()
    for i, p in enumerate(parts):
        if i:
            h.update(b":")
        h.update(p.encode() if isinstance(p, str) else p)
    return h.hexdigest()


def between(s, a, b):
    i = s.find(a)
    if i < 0:
        return ""
    i += len(a)
    j = s.find(b, i)
    return s[i:j] if j >= 0 else ""


class MpegtsMuxer:
    def __init__(self):
        self.pts = self.seq = self.timestamp = 0

    def _crc32(self, data):
        crc = 0xFFFFFFFF
        for b in data:
            crc ^= b << 24
            for _ in range(8):
                crc = (
                    ((crc << 1) ^ 0x04C11DB7) & 0xFFFFFFFF
                    if crc & 0x80000000
                    else (crc << 1) & 0xFFFFFFFF
                )
        return crc

    def _pts_b(self, t):
        b = bytearray(5)
        b[0] = 0x20 | ((t >> 29) & 0x0E) | 1
        b[1] = (t >> 22) & 0xFF
        b[2] = ((t >> 14) & 0xFE) | 1
        b[3] = (t >> 7) & 0xFF
        b[4] = ((t << 1) & 0xFE) | 1
        return bytes(b)

    def _ts(self, pid, payload, pusi, cont):
        pkt = bytearray(188)
        pkt[0] = 0x47
        pf = pid & 0x1FFF
        if pusi:
            pf |= 0x4000
        pkt[1], pkt[2] = (pf >> 8) & 0xFF, pf & 0xFF
        if len(payload) < 184:
            ad = 183 - len(payload)
            pkt[3] = 0x30 | (cont & 0xF)
            pkt[4] = ad
            pkt[5 + ad : 5 + ad + len(payload)] = payload
        else:
            pkt[3] = 0x10 | (cont & 0xF)
            pkt[4:] = payload[:184]
        return bytes(pkt)

    def header(self):
        out = bytearray()
        psi = bytearray([0x00, 0xB0, 0x0D, 0x00, 0x01, 0xC1, 0x00, 0x00, 0x00, 0x01])
        psi += struct.pack(">H", 0xE000 | 0x1000)
        psi += struct.pack("<I", self._crc32(bytes(psi)))
        out += self._ts(0, b"\x00" + bytes(psi), True, 0)
        psi = bytearray([0x02, 0xB0, 0x12, 0x00, 0x01, 0xC1, 0x00, 0x00])
        psi += struct.pack(">H", 0xE000 | 0x1FFF)
        psi += struct.pack(">H", 0xF000)
        psi.append(0x90)
        psi += struct.pack(">H", 0xE000 | 0x100)
        psi += struct.pack(">H", 0xF000)
        psi += struct.pack("<I", self._crc32(bytes(psi)))
        out += self._ts(0x1000, b"\x00" + bytes(psi), True, 0)
        return bytes(out)

    def payload(self, ts_rtp, alaw):
        if self.timestamp:
            self.pts += ts_rtp - self.timestamp
        self.timestamp = ts_rtp
        pes = bytearray(b"\x00\x00\x01\xC0")
        size = 8 + len(alaw)
        pes += struct.pack(">H", size if size <= 0xFFFF else 0)
        pes += bytes([0x80, 0x80, 5]) + self._pts_b(self.pts) + alaw
        out, first, data = bytearray(), True, bytes(pes)
        while data:
            cont = self.seq & 0xF
            self.seq += 1
            if len(data) <= 184:
                out += self._ts(0x100, data, first, cont)
                data = b""
            else:
                out += self._ts(0x100, data[:184], first, cont)
                data = data[184:]
            first = False
        return bytes(out)


def write_audio_part(sock, sid, data: bytes):
    sock.sendall(
        b"----client-stream-boundary--\r\n"
        b"Content-Type: audio/mp2t\r\n"
        b"X-If-Encrypt: 0\r\n"
        b"X-Session-Id: "
        + sid.encode()
        + b"\r\nContent-Length: "
        + str(len(data)).encode()
        + b"\r\n\r\n"
        + data
    )


def open_talk_session():
    ip = _cfg["camera_ip"]
    cloud = _cfg["cloud_pass"]
    pwd_hash = hashlib.sha256(cloud.encode()).hexdigest().upper()
    sock = socket.create_connection((ip, 8800), timeout=10)
    sock.settimeout(12)
    buf = b""

    def send_post(auth=None):
        lines = [
            "POST /stream HTTP/1.1",
            f"Host: {ip}:8800",
            "User-Agent: Go-http-client/1.1",
            "Content-Length: 0",
            "Content-Type: multipart/mixed; boundary=--client-stream-boundary--",
        ]
        if auth:
            lines.append(f"Authorization: {auth}")
        lines += ["", ""]
        sock.sendall("\r\n".join(lines).encode())

    def read_http():
        nonlocal buf
        while b"\r\n\r\n" not in buf:
            buf += sock.recv(4096)
        head, rest = buf.split(b"\r\n\r\n", 1)
        lines = head.decode("latin-1").split("\r\n")
        status = int(lines[0].split()[1])
        hdrs = {}
        for line in lines[1:]:
            if ":" in line:
                k, v = line.split(":", 1)
                hdrs[k.strip().lower()] = v.strip()
        cl = int(hdrs.get("content-length") or 0)
        while len(rest) < cl:
            rest += sock.recv(4096)
        buf = rest[cl:]
        return status, hdrs

    send_post()
    st, hdrs = read_http()
    if st != 401:
        sock.close()
        raise RuntimeError(f"401 expected, got {st}")
    www = hdrs["www-authenticate"]
    realm, nonce = between(www, 'realm="', '"'), between(www, 'nonce="', '"')
    qop, opaque = between(www, 'qop="', '"') or "auth", between(www, 'opaque="', '"')
    nc = "00000001"
    cnonce = "".join(
        random.choice(
            "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        )
        for _ in range(32)
    )
    resp = md5_colon(
        md5_colon("admin", realm, pwd_hash),
        nonce,
        nc,
        cnonce,
        qop,
        md5_colon("POST", "/stream"),
    )
    auth = (
        f'Digest username="admin", realm="{realm}", nonce="{nonce}", '
        f'uri="/stream", qop={qop}, nc={nc}, cnonce="{cnonce}", response="{resp}"'
    )
    if opaque:
        auth += f', opaque="{opaque}", algorithm=MD5'
    send_post(auth)
    if read_http()[0] != 200:
        sock.close()
        raise RuntimeError("auth failed")

    body = json.dumps(
        {
            "params": {"talk": {"mode": "aec"}, "method": "get"},
            "seq": 3,
            "type": "request",
        }
    ).encode()
    sock.sendall(
        b"----client-stream-boundary--\r\nContent-Type: application/json\r\n"
        b"Content-Length: "
        + str(len(body)).encode()
        + b"\r\n\r\n"
        + body
        + b"\r\n"
    )
    sid = None
    end = time.time() + 8
    while time.time() < end:
        m = re.search(rb'"session_id"\s*:\s*"?(\w+)"?', buf)
        if m:
            sid = m.group(1).decode()
            break
        try:
            sock.settimeout(1)
            c = sock.recv(4096)
            if not c:
                break
            buf += c
        except socket.timeout:
            pass
    if not sid:
        sock.close()
        raise RuntimeError("no session_id")
    return sock, sid, MpegtsMuxer()


def speak_file(path: Path, stop_event: threading.Event):
    vol = _cfg.get("volume", 2.5)
    alaw = subprocess.check_output(
        [
            "ffmpeg",
            "-y",
            "-hide_banner",
            "-loglevel",
            "error",
            "-i",
            str(path),
            "-vn",
            "-af",
            f"volume={vol},aresample=8000",
            "-c:a",
            "pcm_alaw",
            "-ar",
            "8000",
            "-ac",
            "1",
            "-f",
            "alaw",
            "pipe:1",
        ]
    )
    sock, sid, mux = open_talk_session()
    try:
        write_audio_part(sock, sid, mux.header())
        frame, ts, t0, sent = 160, 0, time.time(), 0
        for i in range(0, len(alaw), frame):
            if stop_event.is_set():
                break
            chunk = alaw[i : i + frame]
            if len(chunk) < frame:
                chunk += b"\xD5" * (frame - len(chunk))
            write_audio_part(sock, sid, mux.payload(ts, chunk))
            ts += frame
            sent += frame
            d = t0 + sent / 8000.0 - time.time()
            if d > 0.001:
                time.sleep(d)
        time.sleep(0.2)
    finally:
        try:
            sock.close()
        except Exception:
            pass
